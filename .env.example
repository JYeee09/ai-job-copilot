# ============================================================
# AI Job Copilot Web — 环境变量配置
# 复制本文件为 .env 后填写（.env 会被 .gitignore 忽略，不会提交）
# ============================================================

# Dify API 地址
#   云版（cloud.dify.ai）：https://api.dify.ai/v1
#   自部署（社区版）：    http://<你的服务器>/v1
DIFY_BASE_URL=

# Dify 应用的 API Key
#   在 Dify 应用页面右上角「API 访问」中生成（app 级密钥，前缀 app-）
DIFY_API_KEY=

# 演示模式：true 时不调用 Dify，返回示例数据（用于先看界面效果）
DIFY_MOCK=false

# 服务监听端口，默认 8787
PORT=8787
