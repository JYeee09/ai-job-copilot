# ============================================================
# AI Job Copilot Web — 环境变量配置
# 复制本文件为 .env 后填写（.env 会被 .gitignore 忽略，不会提交）
# ============================================================

# Dify API 地址
#   云版（cloud.dify.ai）：https://api.dify.ai/v1
#   自部署（社区版）：    http://<你的服务器>/v1
DIFY_BASE_URL=

# Dify 应用的 API Key
#   在 Dify 应用页面右上角「API 访问」中生成（app 级密钥，前缀 app-）
DIFY_API_KEY=

# 演示模式：true 时不调用 Dify，返回示例数据（用于先看界面效果）
DIFY_MOCK=false

# 服务监听端口，默认 8787
PORT=8787

# ============================================================
# 岗位推荐子页面（飞书多维表格「秋招岗位库」读取）
# 应用需在飞书开放平台创建（open.feishu.cn），开通多维表格只读权限，
# 发布版本后把「秋招岗位库」表格分享给该应用（协作者），
# 再把以下四个值填到 Render 环境变量（本地填 .env）。
# ============================================================

# 飞书开放平台自建应用 App ID（cli_ 开头）
FEISHU_APP_ID=

# 飞书开放平台自建应用 App Secret
FEISHU_APP_SECRET=

# 秋招岗位库 Base token（多维表格 URL 中 /base/ 后面那段）
FEISHU_BASE_TOKEN=

# 岗位记录表 Table ID（多维表格里表名下方的 tbl 开头 ID）
FEISHU_TABLE_ID=
